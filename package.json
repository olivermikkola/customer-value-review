{
  "name": "lanka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LANKA — elävä asiakaskatsaus. Todisteketju operatiivisista tapahtumista asiakkaalle näkyviin väitteisiin.",
  "scripts": {
    "seed": "node src/cli.ts seed",
    "facts": "node src/cli.ts facts",
    "review": "node src/cli.ts review",
    "write": "node src/cli.ts write",
    "verify": "node src/cli.ts verify",
    "ui": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run verify",
    "models": "node scripts/fetch-models.ts",
    "pack": "node src/pack/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.65.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "pptxgenjs": "^4.0.1"
  }
}
