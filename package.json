{
  "name": "customer-value-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Customer Value Review for the Lindström challenge at Since AI Hackathon 2026: traceable customer value and sustainability analytics.",
  "scripts": {
    "verify": "node src/pack/cli.ts",
    "ui": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run verify",
    "models": "node scripts/fetch-models.ts",
    "static": "node scripts/build-static.ts",
    "pack": "node src/pack/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.65.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "pptxgenjs": "^4.0.1"
  }
}
